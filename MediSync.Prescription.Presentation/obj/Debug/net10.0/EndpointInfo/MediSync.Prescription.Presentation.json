          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      },
      "CreatePrescriptionRequest": {
        "required": [
          "patientId",
          "doctorId",
          "drugName",
          "dosage",
          "genericName",
          "frequency",
          "route",
          "durationDays",
          "specialInstructions",
          "notes"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "doctorId": {
            "type": "string",
            "format": "uuid"
          },
          "drugName": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "genericName": {
            "type": [
              "null",
              "string"
            ]
          },
          "frequency": {
            "$ref": "#/components/schemas/FrequencyType"
          },
          "route": {
            "$ref": "#/components/schemas/RouteOfAdministration"
          },
          "durationDays": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "specialInstructions": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
