@{
    ViewData["Title"] = "Health Assistant";
    var firstName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
    var lastName = User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value;
    var fullName = $"{firstName} {lastName}".Trim();
}

@section Styles {
    <style>
        .chat-wrapper {
            display: flex;
            flex-direction: column;
            height: calc(100vh - 120px);
            background: #fff;
            border: 0.5px solid #e2e8f0;
            border-radius: 12px;
            overflow: hidden;
            max-width: 720px;
        }

        .chat-header {
            background: #1B4F8A;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .chat-header-icon {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.15);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .chat-header-title {
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .chat-header-sub {
            font-size: 11px;
            color: rgba(255,255,255,0.65);
            margin-top: 2px;
        }

        .chat-status {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            color: rgba(255,255,255,0.65);
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background: #2ECC71;
            border-radius: 50%;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            background: #f8fafc;
        }

        .msg-ai {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .msg-user {
            display: flex;
            justify-content: flex-end;
        }

        .ai-avatar {
            width: 32px;
            height: 32px;
            background: #1B4F8A;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: #fff;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .ai-bubble {
            background: #fff;
            border: 0.5px solid #e2e8f0;
            border-radius: 0 12px 12px 12px;
            padding: 12px 14px;
            max-width: 75%;
            font-size: 13px;
            color: #2d3748;
            line-height: 1.6;
        }

        .user-bubble {
            background: #1B4F8A;
            border-radius: 12px 0 12px 12px;
            padding: 12px 14px;
            max-width: 75%;
            font-size: 13px;
            color: #fff;
            line-height: 1.6;
        }

        .msg-time {
            font-size: 10px;
            color: #a0aec0;
            margin-top: 4px;
        }

        .msg-time-right {
            text-align: right;
        }

        .typing-dots {
            display: flex;
            gap: 4px;
            padding: 12px 14px;
            background: #fff;
            border: 0.5px solid #e2e8f0;
            border-radius: 0 12px 12px 12px;
        }

            .typing-dots span {
                width: 7px;
                height: 7px;
                background: #a0aec0;
                border-radius: 50%;
                animation: bounce 1.2s infinite;
            }

                .typing-dots span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .typing-dots span:nth-child(3) {
                    animation-delay: 0.4s;
                }

        @@keyframes bounce {
            0%, 60%, 100% {
                transform: translateY(0);
            }

            30% {
                transform: translateY(-6px);
            }
        }

        .suggestions {
            padding: 10px 16px;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            flex-shrink: 0;
            background: #fff;
            border-top: 0.5px solid #e2e8f0;
        }

        .suggestion-chip {
            background: #f7fafc;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 5px 12px;
            font-size: 12px;
            color: #1B4F8A;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.15s;
            white-space: nowrap;
        }

            .suggestion-chip:hover {
                background: #EBF4FF;
                border-color: #1B4F8A;
            }

        .chat-input-area {
            border-top: 0.5px solid #e2e8f0;
            padding: 14px 16px;
            display: flex;
            align-items: flex-end;
            gap: 10px;
            flex-shrink: 0;
            background: #fff;
        }

        .chat-input {
            flex: 1;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 13px;
            color: #2d3748;
            background: #f7fafc;
            resize: none;
            outline: none;
            font-family: inherit;
            line-height: 1.5;
            max-height: 120px;
            overflow-y: auto;
        }

            .chat-input:focus {
                border-color: #1B4F8A;
                background: #fff;
            }

        .send-btn {
            width: 40px;
            height: 40px;
            background: #1B4F8A;
            border: none;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
            transition: background 0.15s;
        }

            .send-btn:hover {
                background: #15407a;
            }

            .send-btn:disabled {
                background: #a0aec0;
                cursor: not-allowed;
            }

            .send-btn i {
                color: #fff;
                font-size: 16px;
            }

        .ai-bubble strong {
            font-weight: 600;
            color: #1a202c;
        }

        .ai-bubble ul {
            margin: 6px 0 0 16px;
            padding: 0;
        }

        .ai-bubble li {
            margin-bottom: 4px;
        }

        .ai-bubble p {
            margin-bottom: 6px;
        }

            .ai-bubble p:last-child {
                margin-bottom: 0;
            }
    </style>
}

<div class="chat-wrapper">

    @* Header *@
    <div class="chat-header">
        <div class="chat-header-icon">🏥</div>
        <div>
            <div class="chat-header-title">MediSync Health Assistant</div>
            <div class="chat-header-sub">
                Ask anything about your health records
            </div>
        </div>
        <div class="chat-status">
            <div class="status-dot"></div>
            Online
        </div>
    </div>

    @* Messages *@
    <div class="chat-messages" id="chatMessages">
        <div class="msg-ai">
            <div class="ai-avatar">🤖</div>
            <div>
                <div class="ai-bubble">
                    Hello <strong>@firstName</strong>! 👋 I am your personal
                    health assistant. I can answer questions about your medical
                    records, allergies, medications, and recent visits.
                    What would you like to know today?
                </div>
                <div class="msg-time">Just now</div>
            </div>
        </div>
    </div>

    @* Suggestions *@
    <div class="suggestions">
        <div class="suggestion-chip" data-question="What am I allergic to?">
            💊 My allergies
        </div>
        <div class="suggestion-chip"
             data-question="What medications am I currently taking?">
            💉 My medications
        </div>
        <div class="suggestion-chip"
             data-question="When was my last doctor visit?">
            🏥 Last visit
        </div>
        <div class="suggestion-chip"
             data-question="What are my active medical conditions?">
            🩺 My conditions
        </div>
        <div class="suggestion-chip"
             data-question="Give me a summary of my health records">
            📋 Health summary
        </div>
    </div>

    @* Input *@
    <div class="chat-input-area">
        <textarea id="chatInput"
                  class="chat-input"
                  placeholder="Ask about your health records..."
                  rows="1"></textarea>
        <button class="send-btn" id="sendBtn">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

@* Anti-forgery token *@
<form id="tokenForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        $(document).ready(function() {

            var $messages = $('#chatMessages');
            var $input = $('#chatInput');
            var $sendBtn = $('#sendBtn');
            var token = $('input[name="__RequestVerificationToken"]').val();

            // ── Auto resize textarea ──────────────────────
            $input.on('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });

            // ── Send on Enter ─────────────────────────────
            $input.on('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });

            // ── Send button click ─────────────────────────
            $sendBtn.on('click', function() {
                sendMessage();
            });

            // ── Suggestion chips ──────────────────────────
            $(document).on('click', '.suggestion-chip', function() {
                var question = $(this).data('question');
                $input.val(question);
                sendMessage();
            });

            // ── Send message ──────────────────────────────
            function sendMessage() {
                var message = $input.val().trim();
                if (!message) return;

                // Clear input
                $input.val('').css('height', 'auto');

                // Disable send
                $sendBtn.prop('disabled', true);

                // Add user message
                appendUserMessage(message);

                // Show typing
                var typingId = showTyping();

                // AJAX call
                $.ajax({
                    url: '/Chat/index',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify({ message: message }),
                    success: function(data) {
                        removeTyping(typingId);
                        appendAIMessage(data.answer);
                    },
                    error: function() {
                        removeTyping(typingId);
                        appendAIMessage(
                            'I encountered an error. Please try again.');
                    },
                    complete: function() {
                        $sendBtn.prop('disabled', false);
                        $input.focus();
                    }
                });
            }

            // ── Append user message ───────────────────────
            function appendUserMessage(text) {
                var time = getCurrentTime();
                var html = '<div class="msg-user">' +
                    '<div>' +
                    '<div class="user-bubble">' +
                    escapeHtml(text) +
                    '</div>' +
                    '<div class="msg-time msg-time-right">' +
                    time +
                    '</div>' +
                    '</div>' +
                    '</div>';
                $messages.append(html);
                scrollToBottom();
            }

            // ── Append AI message ─────────────────────────
            function appendAIMessage(text) {
                var time = getCurrentTime();
                var html = '<div class="msg-ai">' +
                    '<div class="ai-avatar">🤖</div>' +
                    '<div>' +
                    '<div class="ai-bubble">' +
                    formatMessage(text) +
                    '</div>' +
                    '<div class="msg-time">' + time + '</div>' +
                    '</div>' +
                    '</div>';
                $messages.append(html);
                scrollToBottom();
            }

            // ── Typing indicator ──────────────────────────
            function showTyping() {
                var id = 'typing-' + Date.now();
                var html = '<div class="msg-ai" id="' + id + '">' +
                    '<div class="ai-avatar">🤖</div>' +
                    '<div class="typing-dots">' +
                    '<span></span>' +
                    '<span></span>' +
                    '<span></span>' +
                    '</div>' +
                    '</div>';
                $messages.append(html);
                scrollToBottom();
                return id;
            }

            function removeTyping(id) {
                $('#' + id).remove();
            }

            // ── Helpers ───────────────────────────────────
            function scrollToBottom() {
                $messages.scrollTop($messages[0].scrollHeight);
            }

            function getCurrentTime() {
                return new Date().toLocaleTimeString([], {
                    hour: '2-digit', minute: '2-digit'
                });
            }

            function escapeHtml(text) {
                return $('<div>').text(text).html();
            }

            function formatMessage(text) {
                return text
                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*(.*?)\*/g, '<em>$1</em>')
                    .replace(/\n\n/g, '</p><p>')
                    .replace(/\n/g, '<br>')
                    .replace(/^/, '<p>')
                    .replace(/$/, '</p>');
            }
        });
    </script>
}