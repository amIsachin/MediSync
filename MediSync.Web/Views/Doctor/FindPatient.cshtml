@model MediSync.Web.ViewModels.FindPatientViewModel

@{
    ViewData["Title"] = "Find Patient";
}

@section Styles {
    <style>
        .find-card {
            background: #fff;
            border: 0.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 32px;
            max-width: 480px;
        }

        .find-title {
            font-size: 18px;
            font-weight: 600;
            color: #1a202c;
            margin-bottom: 6px;
        }

        .find-subtitle {
            font-size: 13px;
            color: #718096;
            margin-bottom: 28px;
        }

        .field label {
            font-size: 11px;
            font-weight: 600;
            color: #4a5568;
            display: block;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .field .form-control {
            padding: 10px 14px 10px 38px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            color: #2d3748;
            background: #f7fafc;
            width: 100%;
            outline: none;
            transition: border-color 0.15s;
        }

            .field .form-control:focus {
                border-color: #1B4F8A;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(27,79,138,0.08);
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #a0aec0;
                font-size: 15px;
            }

        .btn-find {
            width: 100%;
            padding: 11px;
            background: #1B4F8A;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
            transition: background 0.15s;
        }

            .btn-find:hover {
                background: #15407a;
            }

        .validation-error {
            font-size: 11px;
            color: #E53E3E;
            margin-top: 4px;
            display: block;
        }

        .spinner {
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            display: none;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
}

<div class="page-header mb-4">
    <h1 style="font-size:20px;font-weight:600;color:#1a202c;">Find Patient</h1>
    <p style="font-size:13px;color:#718096;margin-top:3px;">
        Search for a patient by their registered email address
    </p>
</div>

@* Notification *@
@if (TempData["NotificationMessage"] != null)
{
    var isSuccess = TempData["NotificationType"]?.ToString() == "Success";
    var borderColor = isSuccess ? "border-success" : "border-danger";
    var iconBg = isSuccess ? "bg-success-subtle" : "bg-danger-subtle";
    var iconColor = isSuccess ? "text-success" : "text-danger";
    var icon = isSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill";
    var title = isSuccess ? "Found" : "Not Found";
    var bgColor = isSuccess ? "bg-success-subtle" : "bg-danger-subtle";

    <div id="notifBox"
         class="d-flex align-items-start gap-3 p-3 rounded-3 border-start border-4
        @borderColor @bgColor mb-3 position-relative" style="max-width:480px;">
        <div class="@iconBg @iconColor rounded-2 d-flex align-items-center
            justify-content-center flex-shrink-0"
             style="width:38px;height:38px;font-size:18px;">
            <i class="bi @icon"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fw-bold small @iconColor">@title</div>
            <div class="text-secondary" style="font-size:12px;margin-top:2px;">
                @TempData["NotificationMessage"]
            </div>
        </div>
        <i class="bi bi-x-lg flex-shrink-0 @iconColor"
           style="font-size:14px;cursor:pointer;opacity:0.7;"
           onclick="document.getElementById('notifBox').remove()"></i>
    </div>
}

<div class="find-card">
    <div class="find-title">Search by email</div>
    <div class="find-subtitle">
        Enter the patient's registered email address to view their medical profile.
    </div>

    <form asp-action="FindPatient" method="post" id="findForm">
        @Html.AntiForgeryToken()

        <div class="field">
            <label>Patient email address</label>
            <div class="input-wrap">
                <i class="bi bi-envelope"></i>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="patient@gmail.com"
                       type="email"
                       autofocus />
            </div>
            <span asp-validation-for="Email" class="validation-error"></span>
        </div>

        <button type="submit" class="btn-find" id="findBtn">
            <span class="spinner" id="spinner"></span>
            <i class="bi bi-search" id="searchIcon"></i>
            <span id="btnText">Find Patient</span>
        </button>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('findForm').addEventListener('submit', function() {
            document.getElementById('spinner').style.display = 'inline-block';
            document.getElementById('searchIcon').style.display = 'none';
            document.getElementById('btnText').textContent = 'Searching...';
            document.getElementById('findBtn').disabled = true;
        });
    </script>
}