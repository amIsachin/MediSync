@model MediSync.Web.ViewModels.AddDiagnosisViewModel

@{
    ViewData["Title"] = "Add Diagnosis";
}

@section Styles {
    <style>
        .form-card {
            background: #fff;
            border: 0.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 28px;
            max-width: 520px;
        }

        .field label {
            font-size: 11px;
            font-weight: 600;
            color: #4a5568;
            display: block;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .field .form-control {
            padding: 9px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            color: #2d3748;
            background: #f7fafc;
            width: 100%;
            outline: none;
        }

            .field .form-control:focus {
                border-color: #8E44AD;
                background: #fff;
            }

        .validation-error {
            font-size: 11px;
            color: #E53E3E;
            margin-top: 4px;
            display: block;
        }

        .btn-save {
            width: 100%;
            padding: 11px;
            background: #8E44AD;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 8px;
        }

        .required {
            color: #E53E3E;
            margin-left: 2px;
        }

        .icd-hint {
            font-size: 11px;
            color: #a0aec0;
            margin-top: 4px;
        }
    </style>
}

<div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:20px;font-weight:600;color:#1a202c;">Add Diagnosis</h1>
        <p style="font-size:13px;color:#718096;margin-top:3px;">
            Recording diagnosis for <strong>@Model.PatientName</strong>
        </p>
    </div>
    <a asp-controller="Doctor" asp-action="PatientDetail"
       asp-route-patientId="@Model.PatientId"
       class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="form-card">
    <form asp-action="AddDiagnosis" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PatientId" />
        <input type="hidden" asp-for="PatientName" />

        <div class="field mb-3">
            <label>ICD-10 Code <span class="required">*</span></label>
            <input asp-for="IcdCode" class="form-control"
                   placeholder="e.g. I10, E11, J18.9" autofocus />
            <div class="icd-hint">
                Common codes: I10 = Hypertension, E11 = Type 2 Diabetes,
                J18.9 = Pneumonia, K21 = GERD
            </div>
            <span asp-validation-for="IcdCode" class="validation-error"></span>
        </div>

        <div class="field mb-3">
            <label>Description <span class="required">*</span></label>
            <textarea asp-for="Description" class="form-control" rows="4"
                      placeholder="Plain language description of the diagnosis"></textarea>
            <span asp-validation-for="Description" class="validation-error"></span>
        </div>

        <button type="submit" class="btn-save">
            <i class="bi bi-clipboard2-pulse"></i> Record Diagnosis
        </button>
    </form>
</div>