@model MediSync.Web.ViewModels.WritePrescriptionViewModel

@{
    ViewData["Title"] = "Write Prescription";
}

@section Styles {
    <style>
        .rx-card {
            background: #fff;
            border: 0.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 28px;
            max-width: 640px;
        }

        .rx-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #e2e8f0;
        }

        .rx-icon {
            width: 42px;
            height: 42px;
            background: #EBF4FF;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #1B4F8A;
        }

        .rx-title {
            font-size: 16px;
            font-weight: 600;
            color: #1a202c;
        }

        .rx-sub {
            font-size: 12px;
            color: #718096;
            margin-top: 2px;
        }

        .section-label {
            font-size: 11px;
            font-weight: 700;
            color: #1B4F8A;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 12px;
            margin-top: 20px;
            padding-bottom: 6px;
            border-bottom: 1px solid #e2e8f0;
        }

        .row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .row-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 14px;
        }

        .field label {
            font-size: 11px;
            font-weight: 600;
            color: #4a5568;
            display: block;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .field .form-control,
        .field .form-select {
            padding: 9px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            color: #2d3748;
            background: #f7fafc;
            width: 100%;
            outline: none;
            transition: border-color 0.15s;
        }

            .field .form-control:focus,
            .field .form-select:focus {
                border-color: #1B4F8A;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(27,79,138,0.08);
            }

        .validation-error {
            font-size: 11px;
            color: #E53E3E;
            margin-top: 4px;
            display: block;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background: #1B4F8A;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
            transition: background 0.15s;
        }

            .btn-submit:hover {
                background: #15407a;
            }

        .required {
            color: #E53E3E;
            margin-left: 2px;
        }

        .spinner {
            width: 14px;
            height: 14px;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            display: none;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
}

<div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:20px;font-weight:600;color:#1a202c;">Write Prescription</h1>
        <p style="font-size:13px;color:#718096;margin-top:3px;">
            @if (!string.IsNullOrEmpty(Model.PatientName))
            {
                <span>Writing prescription for <strong>@Model.PatientName</strong></span>
            }
            else
            {
                <span>Complete the prescription details below</span>
            }
        </p>
    </div>
    @if (Model.PatientId != Guid.Empty)
    {
        <a asp-controller="Doctor" asp-action="PatientDetail"
           asp-route-patientId="@Model.PatientId"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to Patient
        </a>
    }
</div>

@* Notification *@
@if (TempData["NotificationMessage"] != null)
{
    var isSuccess = TempData["NotificationType"]?.ToString() == "Success";
    var borderColor = isSuccess ? "border-success" : "border-danger";
    var iconBg = isSuccess ? "bg-success-subtle" : "bg-danger-subtle";
    var iconColor = isSuccess ? "text-success" : "text-danger";
    var icon = isSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill";
    var title = isSuccess ? "Prescription Written" : "Error";
    var bgColor = isSuccess ? "bg-success-subtle" : "bg-danger-subtle";

    <div id="notifBox"
         class="d-flex align-items-start gap-3 p-3 rounded-3 border-start border-4
        @borderColor @bgColor mb-3 position-relative" style="max-width:640px;">
        <div class="@iconBg @iconColor rounded-2 d-flex align-items-center
            justify-content-center flex-shrink-0"
             style="width:38px;height:38px;font-size:18px;">
            <i class="bi @icon"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fw-bold small @iconColor">@title</div>
            <div class="text-secondary" style="font-size:12px;margin-top:2px;">
                @TempData["NotificationMessage"]
            </div>
        </div>
        <i class="bi bi-x-lg flex-shrink-0 @iconColor"
           style="font-size:14px;cursor:pointer;opacity:0.7;"
           onclick="document.getElementById('notifBox').remove()"></i>
    </div>
}

<div class="rx-card">

    @* Rx Header *@
    <div class="rx-header">
        <div class="rx-icon"><i class="bi bi-capsule"></i></div>
        <div>
            <div class="rx-title">New Prescription</div>
            <div class="rx-sub">
                All prescriptions are permanently recorded and cannot be edited
            </div>
        </div>
    </div>

    <form asp-action="WritePrescription" method="post" id="rxForm">
        @Html.AntiForgeryToken()

        @* Hidden fields *@
        <input type="hidden" asp-for="PatientId" />
        <input type="hidden" asp-for="PatientName" />

        @* ── Drug Information ── *@
        <div class="section-label">
            <i class="bi bi-capsule"></i> Drug Information
        </div>

        <div class="row-2 mb-3">
            <div class="field">
                <label>Drug name <span class="required">*</span></label>
                <input asp-for="DrugName"
                       class="form-control"
                       placeholder="e.g. Metformin" />
                <span asp-validation-for="DrugName" class="validation-error"></span>
            </div>
            <div class="field">
                <label>Dosage <span class="required">*</span></label>
                <input asp-for="Dosage"
                       class="form-control"
                       placeholder="e.g. 500mg" />
                <span asp-validation-for="Dosage" class="validation-error"></span>
            </div>
        </div>

        <div class="field mb-3">
            <label>Generic name</label>
            <input asp-for="GenericName"
                   class="form-control"
                   placeholder="e.g. Metformin Hydrochloride (optional)" />
        </div>

        @* ── Dosage Instructions ── *@
        <div class="section-label">
            <i class="bi bi-list-check"></i> Dosage Instructions
        </div>

        <div class="row-3 mb-3">
            <div class="field">
                <label>Frequency <span class="required">*</span></label>
                <select asp-for="Frequency" class="form-select">
                    <option value="OnceDaily">Once Daily</option>
                    <option value="TwiceDaily">Twice Daily</option>
                    <option value="ThriceDaily">Thrice Daily</option>
                    <option value="FourTimesDaily">Four Times Daily</option>
                    <option value="AsNeeded">As Needed</option>
                    <option value="Weekly">Weekly</option>
                    <option value="Monthly">Monthly</option>
                </select>
            </div>
            <div class="field">
                <label>Route <span class="required">*</span></label>
                <select asp-for="Route" class="form-select">
                    <option value="Oral">Oral</option>
                    <option value="Intravenous">Intravenous</option>
                    <option value="Topical">Topical</option>
                    <option value="Inhalation">Inhalation</option>
                    <option value="Subcutaneous">Subcutaneous</option>
                    <option value="Intramuscular">Intramuscular</option>
                </select>
            </div>
            <div class="field">
                <label>Duration (days) <span class="required">*</span></label>
                <input asp-for="DurationDays"
                       class="form-control"
                       type="number"
                       min="1"
                       max="365"
                       placeholder="e.g. 30" />
                <span asp-validation-for="DurationDays" class="validation-error"></span>
            </div>
        </div>

        <div class="field mb-3">
            <label>Special instructions</label>
            <input asp-for="SpecialInstructions"
                   class="form-control"
                   placeholder="e.g. Take with food (optional)" />
        </div>

        @* ── Notes ── *@
        <div class="section-label">
            <i class="bi bi-journal-text"></i> Doctor Notes
        </div>

        <div class="field mb-3">
            <label>Notes</label>
            <textarea asp-for="Notes"
                      class="form-control"
                      rows="3"
                      placeholder="Any additional notes for this prescription (optional)"></textarea>
        </div>

        <button type="submit" class="btn-submit" id="rxBtn">
            <span class="spinner" id="spinner"></span>
            <i class="bi bi-check-lg" id="rxIcon"></i>
            <span id="btnText">Write Prescription</span>
        </button>

    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('rxForm').addEventListener('submit', function () {
            document.getElementById('spinner').style.display = 'inline-block';
            document.getElementById('rxIcon').style.display  = 'none';
            document.getElementById('btnText').textContent   = 'Writing...';
            document.getElementById('rxBtn').disabled        = true;
        });
    </script>
}