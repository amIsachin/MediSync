@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="sidebar-section">
    <div class="sidebar-label">Main</div>

    <a asp-controller="Home" asp-action="Index"
       class="nav-item @(controller == "Home" ? "active" : "")">
        <i class="bi bi-grid-1x2"></i> Dashboard
    </a>

    <a asp-controller="Doctor" asp-action="FindPatient"
       class="nav-item @(controller == "Doctor" && action == "FindPatient" ? "active" : "")">
        <i class="bi bi-search-heart"></i> Find Patient
    </a>

    <a asp-controller="Doctor" asp-action="WritePrescription"
       class="nav-item @(controller == "Doctor" && action == "WritePrescription" ? "active" : "")">
        <i class="bi bi-capsule"></i> Write Prescription
    </a>
</div>

<div class="sidebar-section">
    <div class="sidebar-label">Clinical</div>

    <a href="#" class="nav-item disabled">
        <i class="bi bi-clipboard2-pulse"></i> Lab Results
    </a>

    <a href="#" class="nav-item disabled">
        <i class="bi bi-shield-check"></i> Consent Grants
    </a>
</div>