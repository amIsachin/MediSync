@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="sidebar-section">
    <div class="sidebar-label">Main</div>
    <a asp-controller="Home" asp-action="Index" class="nav-item @(controller == "Home" && action == "Index" ? "active" : "")">
        <i class="bi bi-grid-1x2"></i> Dashboard
    </a>
    <a asp-controller="Patient" asp-action="CreateProfile" class="nav-item @(controller == "Patient" && action == "CreateProfile" ? "active" : "")">
        <i class="bi bi-file-medical"></i> My Profile
    </a>
    <a href="#" class="nav-item disabled">
        <i class="bi bi-calendar-event"></i> Appointments
    </a>
</div>

<div class="sidebar-section">
    <div class="sidebar-label">Health</div>
    <a href="#" class="nav-item disabled">
        <i class="bi bi-capsule"></i> Prescriptions
    </a>
    <a href="#" class="nav-item disabled">
        <i class="bi bi-search-heart"></i> Find a Doctor
    </a>
    <a href="#" class="nav-item disabled">
        <i class="bi bi-shield-check"></i> Consent Grants
    </a>
    <a asp-controller="Chat" asp-action="Index"
       class="nav-item @(controller == "Chat" ? "active" : "")">
        <i class="bi bi-chat-heart"></i> Health Chat
    </a>
</div>