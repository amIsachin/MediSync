{
  "openapi": "3.1.1",
  "info": {
    "title": "MediSync.Notification.Presentation | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7005"
    }
  ],
  "paths": {
    "/api/Notification/prescription-created": {
      "post": {
        "tags": [
          "Notification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrescriptionCreatedNotification"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PrescriptionCreatedNotification"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PrescriptionCreatedNotification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Notification/profile-created": {
      "post": {
        "tags": [
          "Notification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientProfileCreatedNotification"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientProfileCreatedNotification"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PatientProfileCreatedNotification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Notification/diagnosis-added": {
      "post": {
        "tags": [
          "Notification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosisAddedNotification"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosisAddedNotification"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosisAddedNotification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/WeatherForecast": {
      "get": {
        "tags": [
          "WeatherForecast"
        ],
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WeatherForecast"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiagnosisAddedNotification": {
        "required": [
          "patientId",
          "patientEmail",
          "patientName",
          "diagnosis",
          "icdCode"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "patientEmail": {
            "type": "string"
          },
          "patientName": {
            "type": "string"
          },
          "diagnosis": {
            "type": "string"
          },
          "icdCode": {
            "type": "string"
          }
        }
      },
      "PatientProfileCreatedNotification": {
        "required": [
          "patientId",
          "patientEmail",
          "patientName"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "patientEmail": {
            "type": "string"
          },
          "patientName": {
            "type": "string"
          }
        }
      },
      "PrescriptionCreatedNotification": {
        "required": [
          "prescriptionId",
          "patientId",
          "fullName",
          "drugName",
          "dosage",
          "frequency",
          "durationDays",
          "prescribedAt",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "prescriptionId": {
            "type": "string",
            "format": "uuid"
          },
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "drugName": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "durationDays": {
            "type": "string"
          },
          "prescribedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Notification"
    },
    {
      "name": "WeatherForecast"
    }
  ]
}